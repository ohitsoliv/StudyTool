    {
      "id": "n_pride",
      "title": "Pride",
      "position": { "x": 50, "y": 440 },
      "layers": [
        {
          "depth": 1,
          "content": "Both a personal stance - refusing shame about one's LGBTQ+ identity - and a worldwide movement of celebrations, marches, and protests rooted in the 1969 Stonewall uprising.",
          "contentType": "text",
          "createdAt": "2026-05-08T00:00:00Z"
        }
      ],
