    {
      "id": "n_gay",
      "title": "gay",
      "position": { "x": 100, "y": 460 },
      "layers": [
        {
          "depth": 1,
          "content": "Romantically and/or sexually attracted to people of the same gender. Often used by men, though historically and currently used as a broader synonym for 'homosexual.'",
          "contentType": "text",
          "createdAt": "2026-05-08T00:00:00Z"
        }
      ],
