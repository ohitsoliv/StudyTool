    {
      "id": "n_romantic_orientation",
      "title": "Romantic Orientation",
      "position": { "x": 1500, "y": 200 },
      "layers": [
        {
          "depth": 1,
          "content": "A pattern of romantic attraction toward other people. Distinguished from sexual orientation under the Split Attraction Model; one can be aromantic but sexually attracted, or vice versa.",
          "contentType": "text",
          "createdAt": "2026-05-08T00:00:00Z"
        }
      ],
      "tags": ["category", "romantic"],
