      "title": "nonbinary",
      "position": { "x": 1180, "y": 320 },
      "layers": [
        {
          "depth": 1,
          "content": "An umbrella term for gender identities that fall outside the male/female binary. Often abbreviated NB or enby. May or may not overlap with trans depending on the individual.",
          "contentType": "text",
          "createdAt": "2026-05-08T00:00:00Z"
