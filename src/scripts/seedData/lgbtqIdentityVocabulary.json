    {
      "id": "n_aromantic",
      "title": "aromantic",
      "position": { "x": 1440, "y": 460 },
      "layers": [
        {
          "depth": 1,
          "content": "Experiencing little or no romantic attraction to others. Aromantic people may still experience sexual attraction, form deep platonic bonds, and live partnered or unpartnered lives by choice.",
