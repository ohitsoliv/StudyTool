      "id": "n_asexual",
      "title": "asexual",
      "position": { "x": 660, "y": 460 },
      "layers": [
        {
          "depth": 1,
          "content": "Experiencing little or no sexual attraction to others. Asexual people may still experience romantic attraction, may have sex, and may be in committed relationships - asexuality describes attraction, not behavior.",
          "contentType": "text",
          "createdAt": "2026-05-08T00:00:00Z"
        }
