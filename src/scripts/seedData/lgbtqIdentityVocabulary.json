    {
      "id": "n_coming_out",
      "title": "Coming Out",
      "position": { "x": 50, "y": 320 },
      "layers": [
        {
          "depth": 1,
          "content": "The process of disclosing one's LGBTQ+ identity to others. Often described as ongoing rather than a single event, since one comes out repeatedly across new contexts.",
          "contentType": "text",
          "createdAt": "2026-05-08T00:00:00Z"
        }
      ],
      "tags": ["concept", "community"],
