    {
      "id": "n_bisexual",
      "title": "bisexual",
      "position": { "x": 420, "y": 460 },
      "layers": [
        {
          "depth": 1,
          "content": "Attracted to people of more than one gender. Modern definitions emphasize 'two or more genders' rather than a strict binary.",
          "contentType": "text",
          "createdAt": "2026-05-08T00:00:00Z"
        },
        {
          "depth": 2,
          "content": "The 'bi' prefix originally referred to a binary view (men and women), but the contemporary community definition (Bisexual Manifesto, 1990) explicitly includes attraction to people of any gender. The boundary with pansexual is debated and often a personal choice.",
          "contentType": "text",
          "createdAt": "2026-05-08T00:00:00Z"
        }
      ],
      "tags": ["sexuality", "plurisexual"],
      "mastery": { "score": 0.7, "lastReviewedAt": null, "reviewCount": 0 },
      "createdAt": "2026-05-08T00:00:00Z",
      "updatedAt": "2026-05-08T00:00:00Z",
      "archived": false,
      "clusterId": null,
      "accessCount": 0,
      "lastAccessedAt": null
    },
    {
      "id": "n_pansexual",
      "title": "pansexual",
      "position": { "x": 540, "y": 460 },
      "layers": [
        {
          "depth": 1,
          "content": "Attracted to people regardless of gender; gender is not a primary factor in attraction. Sometimes summarized as 'hearts not parts.'",
          "contentType": "text",
          "createdAt": "2026-05-08T00:00:00Z"
        }
      ],
      "tags": ["sexuality", "plurisexual"],
