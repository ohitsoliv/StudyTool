    {
      "id": "n_sexual_orientation",
      "title": "Sexual Orientation",
      "position": { "x": 450, "y": 200 },
      "layers": [
        {
          "depth": 1,
          "content": "A pattern of sexual attraction toward other people. Independent of romantic orientation under the Split Attraction Model.",
          "contentType": "text",
          "createdAt": "2026-05-08T00:00:00Z"
        }
      ],
      "tags": ["category", "sexuality"],
