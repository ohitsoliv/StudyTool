      "id": "n_intersex",
      "title": "intersex",
      "position": { "x": 1330, "y": 200 },
      "layers": [
        {
          "depth": 1,
          "content": "Born with sex characteristics (chromosomes, hormones, anatomy) that don't fit typical binary definitions of male or female. A biological status, distinct from gender identity, though often grouped under LGBTQ+.",
          "contentType": "text",
          "createdAt": "2026-05-08T00:00:00Z"
