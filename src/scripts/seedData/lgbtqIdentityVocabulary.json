      "id": "n_questioning",
      "title": "Questioning",
      "position": { "x": 50, "y": 200 },
      "layers": [
        {
          "depth": 1,
          "content": "The process or status of exploring one's own sexual orientation, romantic orientation, or gender identity. The Q in some expansions of LGBTQ+.",
          "contentType": "text",
          "createdAt": "2026-05-08T00:00:00Z"
        }
      ],
      "tags": ["concept", "community"],
