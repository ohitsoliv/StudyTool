      "id": "n_plurisexual",
      "title": "Plurisexual",
      "position": { "x": 500, "y": 320 },
      "layers": [
        {
          "depth": 1,
          "content": "Umbrella term for orientations involving attraction to more than one gender. Includes bisexual, pansexual, omnisexual, polysexual.",
          "contentType": "text",
          "createdAt": "2026-05-08T00:00:00Z"
        }
