    {
      "id": "n_monosexual",
      "title": "Monosexual",
      "position": { "x": 200, "y": 320 },
      "layers": [
        {
          "depth": 1,
          "content": "Attracted to only one gender. Includes gay, lesbian, and straight identities. Contrasted with plurisexual orientations.",
          "contentType": "text",
          "createdAt": "2026-05-08T00:00:00Z"
        }
      ],
