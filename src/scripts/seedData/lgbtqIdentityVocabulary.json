{
  "metadata": {
    "name": "LGBTQ+ Identity Vocabulary",
    "description": "Dense taxonomy of LGBTQ+ identity terms. ~46 nodes spanning umbrella terms, sexuality/gender/romantic spectra, and a long tail of microlabels. Some microlabels have empty Layer 1 (definitions vary or are contested) - useful for testing Ghost Web rendering and drill-eligibility gating. Three floating nodes (skoliosexual, abrosexual, genderfae) share tags with no edges, providing Missing Link material."
  },
  "nodes": [
    {
      "id": "n_lgbtq",
      "title": "LGBTQ+",
      "position": { "x": 1000, "y": 80 },
      "layers": [
        {
          "depth": 1,
          "content": "Umbrella acronym for Lesbian, Gay, Bisexual, Transgender, Queer/Questioning, with the + denoting the many additional identities not captured by the letters. The most common collective shorthand for the community.",
          "contentType": "text",
          "createdAt": "2026-05-08T00:00:00Z"
        }
      ],
      "tags": ["umbrella", "community"],
      "mastery": { "score": 0.9, "lastReviewedAt": null, "reviewCount": 0 },
      "createdAt": "2026-05-08T00:00:00Z",
      "updatedAt": "2026-05-08T00:00:00Z",
