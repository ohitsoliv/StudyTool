    {
      "id": "n_asexual_spectrum",
      "title": "Asexual Spectrum",
      "position": { "x": 800, "y": 320 },
      "layers": [
        {
          "depth": 1,
          "content": "The range of identities characterized by little, conditional, or absent sexual attraction. Includes asexual, graysexual, demisexual, aceflux, and others.",
          "contentType": "text",
          "createdAt": "2026-05-08T00:00:00Z"
        }
      ],
