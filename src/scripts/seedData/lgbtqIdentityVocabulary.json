      "clusterId": null,
      "accessCount": 0,
      "lastAccessedAt": null
    },
    {
      "id": "n_queer",
      "title": "queer",
      "position": { "x": 250, "y": 80 },
      "layers": [
        {
          "depth": 1,
          "content": "An umbrella term used by some LGBTQ+ people whose identities don't fit neatly into other labels. Originally a slur, increasingly reclaimed and self-applied since the 1980s.",
          "contentType": "text",
          "createdAt": "2026-05-08T00:00:00Z"
        },
        {
          "depth": 2,
          "content": "Reclamation accelerated through ACT UP and Queer Nation activism in the late 1980s, and through queer theory in academia (Sedgwick, Butler). Usage is generational and context-dependent - still considered a slur by some, especially older community members.",
          "contentType": "text",
          "createdAt": "2026-05-08T00:00:00Z"
        }
      ],
      "tags": ["umbrella", "reclaimed"],
      "mastery": { "score": 0.7, "lastReviewedAt": null, "reviewCount": 0 },
      "createdAt": "2026-05-08T00:00:00Z",
      "updatedAt": "2026-05-08T00:00:00Z",
      "archived": false,
      "clusterId": null,
      "accessCount": 0,
      "lastAccessedAt": null
    },
    {
      "id": "n_sam",
      "title": "Split Attraction Model",
      "position": { "x": 1700, "y": 80 },
      "layers": [
        {
          "depth": 1,
          "content": "A framework distinguishing romantic attraction from sexual attraction as separate axes. Allows identities like 'asexual but biromantic' or 'aromantic but bisexual' to be expressed clearly.",
          "contentType": "text",
          "createdAt": "2026-05-08T00:00:00Z"
        }
      ],
      "tags": ["concept", "framework"],
      "mastery": { "score": 0.55, "lastReviewedAt": null, "reviewCount": 0 },
