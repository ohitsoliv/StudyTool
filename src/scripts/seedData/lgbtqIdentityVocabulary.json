    {
      "id": "n_lesbian",
      "title": "lesbian",
      "position": { "x": 220, "y": 460 },
      "layers": [
        {
          "depth": 1,
          "content": "A woman who is romantically and/or sexually attracted to other women. Also used by some nonbinary people whose identities are connected to womanhood or female-aligned attraction.",
          "contentType": "text",
          "createdAt": "2026-05-08T00:00:00Z"
        }
      ],
      "tags": ["sexuality", "monosexual"],
