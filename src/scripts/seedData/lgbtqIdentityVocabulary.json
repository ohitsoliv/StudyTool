    {
      "id": "n_cis",
      "title": "cis",
      "position": { "x": 1020, "y": 320 },
      "layers": [
        {
          "depth": 1,
          "content": "Short for cisgender: a person whose gender identity matches the sex they were assigned at birth. The complement of trans.",
          "contentType": "text",
          "createdAt": "2026-05-08T00:00:00Z"
        }
      ],
      "tags": ["subcategory", "gender", "cis"],
