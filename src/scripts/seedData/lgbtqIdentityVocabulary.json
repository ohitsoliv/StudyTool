    {
      "id": "n_gender_identity",
      "title": "Gender Identity",
      "position": { "x": 1000, "y": 200 },
      "layers": [
        {
          "depth": 1,
          "content": "A person's internal sense of their own gender, which may or may not correspond to the sex they were assigned at birth.",
          "contentType": "text",
          "createdAt": "2026-05-08T00:00:00Z"
        }
      ],
      "tags": ["category", "gender"],
      "mastery": { "score": 0.7, "lastReviewedAt": null, "reviewCount": 0 },
