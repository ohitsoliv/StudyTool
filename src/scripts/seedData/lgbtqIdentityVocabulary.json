    {
      "id": "n_trans",
      "title": "trans",
      "position": { "x": 880, "y": 320 },
      "layers": [
        {
          "depth": 1,
          "content": "Short for transgender: a person whose gender identity differs from the sex they were assigned at birth. Distinct from sexual orientation; trans people may hold any orientation.",
          "contentType": "text",
          "createdAt": "2026-05-08T00:00:00Z"
        },
        {
          "depth": 2,
          "content": "The 'trans' umbrella historically includes both binary trans identities (trans women, trans men) and many nonbinary identities, though some nonbinary people do not identify as trans. Boundary is contested and personal.",
          "contentType": "text",
          "createdAt": "2026-05-08T00:00:00Z"
        }
      ],
      "tags": ["subcategory", "gender", "trans"],
      "mastery": { "score": 0.65, "lastReviewedAt": null, "reviewCount": 0 },
