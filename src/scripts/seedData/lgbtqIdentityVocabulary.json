    {
      "id": "n_straight",
      "title": "straight",
      "position": { "x": 340, "y": 460 },
      "layers": [
        {
          "depth": 1,
          "content": "Heterosexual: attracted exclusively, or primarily, to people of a different gender (typically the 'opposite' binary gender). The default-assumed orientation in most cultures.",
          "contentType": "text",
          "createdAt": "2026-05-08T00:00:00Z"
        }
      ],
      "tags": ["sexuality", "monosexual"],
      "mastery": { "score": 0.9, "lastReviewedAt": null, "reviewCount": 0 },
