    },
    {
      "id": "n_care_routine",
      "title": "Care Routine",
      "position": { "x": 750, "y": 220 },
      "layers": [
        {
          "depth": 1,
          "content": "The recurring tasks that keep a plant alive: water, feed, repot. Frequency depends on species, season, and pot size.",
          "contentType": "text",
          "createdAt": "2026-05-08T00:00:00Z"
        }
      ],
      "tags": ["care"],
      "mastery": { "score": 0.5, "lastReviewedAt": null, "reviewCount": 0 },
