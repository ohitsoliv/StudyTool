      "id": "n_houseplants",
      "title": "Houseplants",
      "position": { "x": 500, "y": 80 },
      "layers": [
        {
          "depth": 1,
          "content": "Plants grown indoors for decoration, air quality, or general enjoyment. Care reduces to three concerns: light, water, and nutrients.",
          "contentType": "text",
          "createdAt": "2026-05-08T00:00:00Z"
        }
      ],
