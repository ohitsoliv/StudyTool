    {
      "id": "n_light_needs",
      "title": "Light Needs",
      "position": { "x": 250, "y": 220 },
      "layers": [
        {
          "depth": 1,
          "content": "Each plant has a preferred light intensity. Mismatching causes leggy growth (too little) or scorched leaves (too much). Check the species before buying.",
          "contentType": "text",
          "createdAt": "2026-05-08T00:00:00Z"
        }
      ],
      "tags": ["light"],
      "mastery": { "score": 0.6, "lastReviewedAt": null, "reviewCount": 0 },
