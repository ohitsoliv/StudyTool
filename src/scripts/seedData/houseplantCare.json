    },
    {
      "id": "n_low_light",
      "title": "Low Light",
      "position": { "x": 80, "y": 380 },
      "layers": [
        {
          "depth": 1,
          "content": "Indirect or filtered light, several feet from a window or in a room that gets little sun. Snake plants, pothos, and ZZ plants tolerate this well.",
          "contentType": "text",
          "createdAt": "2026-05-08T00:00:00Z"
        }
      ],
      "tags": ["light"],
      "mastery": { "score": 0.4, "lastReviewedAt": null, "reviewCount": 0 },
      "createdAt": "2026-05-08T00:00:00Z",
      "updatedAt": "2026-05-08T00:00:00Z",
      "archived": false,
      "clusterId": null,
      "accessCount": 0,
      "lastAccessedAt": null
    },
    {
      "id": "n_bright_light",
      "title": "Bright Light",
      "position": { "x": 380, "y": 380 },
      "layers": [
        {
          "depth": 1,
          "content": "Direct sun for several hours, or steady bright indirect light close to a south- or west-facing window. Succulents, cacti, and most flowering plants prefer this.",
          "contentType": "text",
          "createdAt": "2026-05-08T00:00:00Z"
        }
      ],
      "tags": ["light"],
      "mastery": { "score": 0.7, "lastReviewedAt": null, "reviewCount": 0 },
      "createdAt": "2026-05-08T00:00:00Z",
      "updatedAt": "2026-05-08T00:00:00Z",
      "archived": false,
      "clusterId": null,
      "accessCount": 0,
      "lastAccessedAt": null
    },
    {
      "id": "n_watering",
      "title": "Watering",
      "position": { "x": 600, "y": 380 },
      "layers": [
        {
          "depth": 1,
          "content": "Water when the top inch of soil is dry. Most houseplants die from overwatering, not underwatering. Drainage holes are non-negotiable.",
          "contentType": "text",
          "createdAt": "2026-05-08T00:00:00Z"
        }
      ],
      "tags": ["care", "water"],
      "mastery": { "score": 0.3, "lastReviewedAt": null, "reviewCount": 0 },
      "createdAt": "2026-05-08T00:00:00Z",
      "updatedAt": "2026-05-08T00:00:00Z",
      "archived": false,
      "clusterId": null,
      "accessCount": 0,
      "lastAccessedAt": null
    },
    {
      "id": "n_fertilizing",
      "title": "Fertilizing",
      "position": { "x": 820, "y": 380 },
      "layers": [
        {
          "depth": 1,
          "content": "Diluted liquid fertilizer every 4-6 weeks during the growing season (spring/summer); pause in winter. Less is more - burnt roots are common.",
          "contentType": "text",
          "createdAt": "2026-05-08T00:00:00Z"
        }
      ],
      "tags": ["care", "nutrients"],
      "mastery": { "score": 0.2, "lastReviewedAt": null, "reviewCount": 0 },
      "createdAt": "2026-05-08T00:00:00Z",
      "updatedAt": "2026-05-08T00:00:00Z",
      "archived": false,
      "clusterId": null,
      "accessCount": 0,
      "lastAccessedAt": null
    },
    {
      "id": "n_repotting",
      "title": "Repotting",
      "position": { "x": 1040, "y": 380 },
      "layers": [
        {
          "depth": 1,
          "content": "Move to a pot one size larger every 1-2 years, or when roots circle the bottom. Best done in spring before active growth resumes.",
          "contentType": "text",
          "createdAt": "2026-05-08T00:00:00Z"
        }
      ],
      "tags": ["care"],
      "mastery": { "score": 0.5, "lastReviewedAt": null, "reviewCount": 0 },
